{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeoRobert630/vibe-code-engineering/tools/phase3-runtime-security/schemas/verification-results.schema.json",
  "title": "Imported Authentication / Session / Authorization verification results",
  "description": "Schema 1.0. Produced by a separate, authorized test suite and validated by phase3-runtime-security (runtime_security.verification.importer). Credential-shaped field names are rejected anywhere in the document; string values are redacted. The importer is the authoritative validator; this schema documents the structure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "producer", "target", "areas"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "vibe-code-engineering/verification-results"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 60},
        "version": {"type": "string", "minLength": 1, "maxLength": 30}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url"],
      "properties": {
        "base_url": {"type": "string", "pattern": "^https?://[^/@\\s]+(/.*)?$", "description": "Must match the origin of the Phase 3 target."}
      }
    },
    "areas": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "authentication": {"$ref": "#/$defs/area", "description": "Findings RT-AUTH-NNN only."},
        "session": {"$ref": "#/$defs/area", "description": "Findings RT-SESSION-NNN only."},
        "authorization": {"$ref": "#/$defs/area", "description": "Findings RT-AUTHZ-NNN only."},
        "idor_bola": {"$ref": "#/$defs/area", "description": "Findings RT-IDOR-NNN only."},
        "tenant_isolation": {"$ref": "#/$defs/area", "description": "Findings RT-TENANT-NNN only."}
      }
    }
  },
  "$defs": {
    "status": {"enum": ["NOT CONFIGURED", "READY", "EXECUTED", "PASS", "FAIL", "INCOMPLETE", "NOT VERIFIED"]},
    "observation": {"enum": ["allowed", "denied", "not_applicable", "error"]},
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "runtime_checks_executed", "requests_count"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "runtime_checks_executed": {"type": "boolean"},
        "requests_count": {"type": "integer", "minimum": 0, "maximum": 20, "description": "The total over all areas must also be <= 20."},
        "findings": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/finding"}},
        "evidence": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/evidence"}},
        "limitations": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "expected", "observed"],
      "properties": {
        "check": {"type": "string", "minLength": 1},
        "expected": {"$ref": "#/$defs/observation"},
        "observed": {"$ref": "#/$defs/observation"},
        "endpoint": {"type": "string", "minLength": 1, "description": "Method and path; query values are redacted."},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{12}$", "description": "HMAC-SHA256 prefix; never a raw value."}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "confidence", "title", "endpoint", "expected", "actual", "evidence", "impact", "recommendation", "validation", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^RT-(AUTH|SESSION|AUTHZ|IDOR|TENANT)-[0-9]{3}$"},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"]},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "status": {"enum": ["OPEN", "REQUIRES_REVIEW"]},
        "title": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1},
        "actual": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1},
        "validation": {"type": "string", "minLength": 1},
        "cwe": {"type": "string", "pattern": "^CWE-[0-9]{1,5}$"},
        "owasp": {"type": "string", "minLength": 1},
        "notes": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
